// rcl.cask -- 彩蛋 rcl()：rcl 是方程235 的女朋友，方程235 永远爱 rcl
function main() {
    rcl(1);                 // 不是 235 -> 什么也不做
    rcl("hello");           // 不认识 -> 什么也不做
    print "前两个都略过了";
    rcl(235);               // 方程235 爱 rcl
    rcl("FC235");           // 方程235 爱 rcl
    rcl("rcl");             // rcl，方程235永远爱你！
    rcl("方程235");         // 方程235 爱 rcl
    print "结束";
}
