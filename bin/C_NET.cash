#define NET_B64BUF 0x160000
static const char b64tab[] =
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
const char *cask_net_base64(const char *s)
{
    static char buf[2][NET_B64BUF];
    static int slot = 0;
    char *out = buf[slot]; slot = (slot + 1) & 1;
    int o = 0;
    if (s) {
        const unsigned char *p = (const unsigned char *)s;
        size_t n = strlen(s);
        if (n > 0x100000) n = 0x100000;
        size_t i = 0;
        while (i < n) {
            unsigned v = p[i] << 16;
            int b1 = (i + 1 < n), b2 = (i + 2 < n);
            if (b1) v |= (unsigned)p[i + 1] << 8;
            if (b2) v |= (unsigned)p[i + 2];
            out[o++] = b64tab[(v >> 18) & 63];
            out[o++] = b64tab[(v >> 12) & 63];
            out[o++] = b1 ? b64tab[(v >> 6) & 63] : '=';
            out[o++] = b2 ? b64tab[v & 63] : '=';
            i += 3;
        }
    }
    out[o] = 0;
    return out;
}
const char *cask_net_unbase64(const char *s)
{
    static char buf[2][0x100000];
    static int slot = 0;
    char *out = buf[slot]; slot = (slot + 1) & 1;
    int o = 0;
    unsigned acc = 0; int bits = 0;
    const size_t CAP = sizeof out - 1;
    if (s) {
        for (const char *p = s; *p; p++) {
            if (*p == '\n' || *p == '\r' || *p == ' ') continue;
            if (*p == '=') break;
            const char *q = strchr(b64tab, *p);
            if (!q) { out[0] = 0; return out; }
            acc = (acc << 6) | (unsigned)(q - b64tab);
            bits += 6;
            if (bits >= 8) {
                bits -= 8;
                if (o < (int)CAP) out[o++] = (char)((acc >> bits) & 0xFF);
            }
        }
    }
    out[o] = 0;
    return out;
}
int cask_net_hostalive(const char *host, int port)
{
    if (!host || !*host || port <= 0) return 0;
    struct addrinfo hints, *res = NULL, *rp;
    char pstr[16];
    snprintf(pstr, sizeof pstr, "%d", port);
    memset(&hints, 0, sizeof hints);
    hints.ai_family = AF_UNSPEC;
    hints.ai_socktype = SOCK_STREAM;
    if (getaddrinfo(host, pstr, &hints, &res) != 0) return 0;
    int alive = 0;
    for (rp = res; rp; rp = rp->ai_next) {
        int s = socket(rp->ai_family, rp->ai_socktype, rp->ai_protocol);
        if (s < 0) continue;
        struct timeval tv; tv.tv_sec = 3; tv.tv_usec = 0;
        setsockopt(s, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof tv);
        setsockopt(s, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof tv);
        if (connect(s, rp->ai_addr, rp->ai_addrlen) == 0) { alive = 1; close(s); break; }
        close(s);
    }
    freeaddrinfo(res);
    return alive;
}

#endif /* _WIN32 / POSIX */

#endif /* CASK_NET_CASH */
