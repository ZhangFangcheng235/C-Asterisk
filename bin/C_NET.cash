}
int cask_net_urlport(const char *url)
{
    if (!url) return 80;
    const char *p = url;
    int secure = 0;
    if (strncmp(p, "https://", 8) == 0) { secure = 1; p += 8; }
    else if (strncmp(p, "http://", 7) == 0) p += 7;
    const char *slash = strchr(p, '/');
    const char *end = slash ? slash : (p + strlen(p));
    char host[512];
    size_t n = (size_t)(end - p);
    if (n > sizeof host - 1) n = sizeof host - 1;
    memcpy(host, p, n); host[n] = 0;
    char *colon = strrchr(host, ':');
    if (colon && colon > host) {
        int prt = atoi(colon + 1);
        return (prt > 0) ? prt : (secure ? 443 : 80);
    }
    return secure ? 443 : 80;
}
int cask_net_fnv1a(const char *s)
{
    unsigned int h = 2166136261u;
    if (s) for (const unsigned char *p = (const unsigned char *)s; *p; p++) {
        h ^= (unsigned char)*p;
        h *= 16777619u;
    }
    return (int)h;
}
#define NET_B64BUF 0x160000
static const char b64tab[] =
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
const char *cask_net_base64(const char *s)
{
    static char buf[2][NET_B64BUF];
    static int slot = 0;
    char *out = buf[slot]; slot = (slot + 1) & 1;
    int o = 0;
    if (s) {
        const unsigned char *p = (const unsigned char *)s;
        size_t n = strlen(s);
        if (n > 0x100000) n = 0x100000;
        size_t i = 0;
        while (i < n) {
            unsigned v = p[i] << 16;
            int b1 = (i + 1 < n), b2 = (i + 2 < n);
            if (b1) v |= (unsigned)p[i + 1] << 8;
            if (b2) v |= (unsigned)p[i + 2];
            out[o++] = b64tab[(v >> 18) & 63];
            out[o++] = b64tab[(v >> 12) & 63];
            out[o++] = b1 ? b64tab[(v >> 6) & 63] : '=';
            out[o++] = b2 ? b64tab[v & 63] : '=';
            i += 3;
        }
    }
    out[o] = 0;
    return out;
}
const char *cask_net_unbase64(const char *s)
{
    static char buf[2][0x100000];
    static int slot = 0;
    char *out = buf[slot]; slot = (slot + 1) & 1;
    int o = 0;
    unsigned acc = 0; int bits = 0;
    const size_t CAP = sizeof buf[0] - 1;
    if (s) {
        for (const char *p = s; *p; p++) {
            if (*p == '\n' || *p == '\r' || *p == ' ') continue;
            if (*p == '=') break;
            const char *q = strchr(b64tab, *p);
            if (!q) { out[0] = 0; return out; }
            acc = (acc << 6) | (unsigned)(q - b64tab);
            bits += 6;
            if (bits >= 8) {
                bits -= 8;
                if (o < (int)CAP) out[o++] = (char)((acc >> bits) & 0xFF);
            }
        }
    }
    out[o] = 0;
    return out;
}
int cask_net_hostalive(const char *host, int port)
{
    if (!host || !*host || port <= 0) return 0;
    struct addrinfo hints, *res = NULL, *rp;
    char pstr[16];
    snprintf(pstr, sizeof pstr, "%d", port);
    memset(&hints, 0, sizeof hints);
    hints.ai_family = AF_UNSPEC;
    hints.ai_socktype = SOCK_STREAM;
    if (getaddrinfo(host, pstr, &hints, &res) != 0) return 0;
    int alive = 0;
    for (rp = res; rp; rp = rp->ai_next) {
        int s = socket(rp->ai_family, rp->ai_socktype, rp->ai_protocol);
        if (s < 0) continue;
        struct timeval tv; tv.tv_sec = 3; tv.tv_usec = 0;
        setsockopt(s, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof tv);
        setsockopt(s, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof tv);
        if (connect(s, rp->ai_addr, rp->ai_addrlen) == 0) { alive = 1; close(s); break; }
        close(s);
    }
    freeaddrinfo(res);
    return alive;
}

/* POSIX 辅助：按主机名 + 端口建一个已连接的 TCP 连接；失败返回 -1 */
static int cask_net_open(const char *host, int port)
{
    if (!host || !*host || port <= 0) return -1;
    char pstr[16];
    snprintf(pstr, sizeof pstr, "%d", port);
    struct addrinfo hints, *res = NULL, *rp;
    memset(&hints, 0, sizeof hints);
    hints.ai_family = AF_INET;
    hints.ai_socktype = SOCK_STREAM;
    if (getaddrinfo(host, pstr, &hints, &res) != 0) return -1;
    int fd = -1;
    for (rp = res; rp; rp = rp->ai_next) {
        if (rp->ai_family != AF_INET) continue;
        int s = socket(rp->ai_family, rp->ai_socktype, rp->ai_protocol);
        if (s < 0) continue;
        struct timeval tv; tv.tv_sec = 4; tv.tv_usec = 0;
        setsockopt(s, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof tv);
        setsockopt(s, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof tv);
        if (connect(s, rp->ai_addr, rp->ai_addrlen) == 0) { fd = s; break; }
        close(s);
    }
    freeaddrinfo(res);
    return fd;
}

/* ---- 主动侦察：bannerget（POSIX） ---- */
const char *cask_net_bannerget(const char *host, int port, const char *probe)
{
    static char buf[2][4096];
    static int slot = 0;
    char *out = buf[slot]; slot = (slot + 1) & 1;
    out[0] = 0;
    int s = cask_net_open(host, port);
    if (s < 0) return out;
    if (probe && *probe) send(s, probe, (int)strlen(probe), 0);
    int n = 0;
    while (n < (int)sizeof buf[0] - 1) {
        int r = recv(s, out + n, 1, 0);
        if (r <= 0) break;
        out[n++] = (char)r;
        if (r == '\n' || r == '\r' || r == '\0' || n >= 512) break;
    }
    out[n] = 0;
    for (int i = 0; i < n; i++)
        if (out[i] == '\n' || out[i] == '\r') { out[i] = 0; break; }
    close(s);
    return out;
}

/* ---- 主动侦察：httpcode（POSIX） ---- */
int cask_net_httpcode(const char *url)
{
    if (!url || !*url) return 0;
    int secure = 0;
    const char *p = url;
    if (strncmp(p, "https://", 8) == 0) { secure = 1; p += 8; }
    else if (strncmp(p, "http://", 7) == 0) p += 7;
    else return 0;
    if (secure) return 0;                            /* 只支持明文 http */
    const char *slash = strchr(p, '/');
    const char *end = slash ? slash : (p + strlen(p));
    char host[512];
    size_t n = (size_t)(end - p);
    if (n > sizeof host - 1) n = sizeof host - 1;
    memcpy(host, p, n); host[n] = 0;
    int port = 80;
    char *colon = strrchr(host, ':');
    if (colon && colon > host) { port = atoi(colon + 1); *colon = 0; }
    if (port <= 0) port = 80;
    char req[600];
    snprintf(req, sizeof req, "GET /%s HTTP/1.0\r\nHost: %s\r\n\r\n", slash ? slash + 1 : "", host);
    static char resp[4096];
    resp[0] = 0;
    int s = cask_net_open(host, port);
    if (s < 0) return 0;
    send(s, req, (int)strlen(req), 0);
    int got = 0;
    while (got < (int)sizeof resp - 1) {
        int r = recv(s, resp + got, 1, 0);
        if (r <= 0) break;
        got++;
        if (resp[got - 1] == '\n' && got > 1 && resp[got - 2] == '\r' && resp[0] == 'H') break;
        if (got >= 4096) break;
    }
    resp[got] = 0;
    close(s);
    if (got < 12 || strncmp(resp, "HTTP/", 5) != 0) return 0;
    int code = atoi(resp + 9);
    return (code > 0) ? code : 0;
}

/* ---- 主动侦察：dnsresolve（POSIX） ---- */
const char *cask_net_dnsresolve(const char *host)
{
    static char buf[2][64];
    static int slot = 0;
    char *out = buf[slot]; slot = (slot + 1) & 1;
    out[0] = 0;
    if (!host || !*host) return out;
    struct in_addr addr;
    if (inet_pton(AF_INET, host, &addr) == 1) {
        strncpy(out, host, sizeof buf[0] - 1);
        out[sizeof buf[0] - 1] = 0;
        return out;                                   /* 已是 IP，原样返回 */
    }
    char pstr[8] = "0";
    struct addrinfo hints, *res = NULL;
    memset(&hints, 0, sizeof hints);
    hints.ai_family = AF_INET;
    hints.ai_socktype = SOCK_STREAM;
    if (getaddrinfo(host, pstr, &hints, &res) != 0) return out;
    for (struct addrinfo *rp = res; rp; rp = rp->ai_next)
        if (rp->ai_family == AF_INET) {
            struct sockaddr_in *sa = (struct sockaddr_in *)rp->ai_addr;
            if (inet_ntop(AF_INET, &sa->sin_addr, out, sizeof buf[0]) != 1) out[0] = 0;
            break;
        }
    freeaddrinfo(res);
    return out;
}

#endif /* _WIN32 / POSIX */

#endif /* CASK_NET_CASH */

