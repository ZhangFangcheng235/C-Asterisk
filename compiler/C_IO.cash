/* ============================================================
 *  C_IO.cash -- C* 的"文件与系统"头（Windows / Linux 通用）
 *
 *      use "C_IO.cash";
 *
 *  打开这些函数（都用 UTF-8 文本，路径就是普通字符串）：
 *
 *      readfile(路径)            读整个文件 -> 文本（读不到返回 ""）
 *      writefile(路径, 内容)     整体写入（覆盖），1 = 成功
 *      appendfile(路径, 内容)    追加到文件末尾，1 = 成功
 *      fileexists(路径)          文件或目录存在 -> 1 / 0
 *      makedir(路径)             建目录（已存在也算成功）-> 1 / 0
 *      appdir()                  本程序（exe）所在目录的完整路径，
 *                                不带末尾分隔符
 *      envget(名字)              读环境变量（没有 -> ""）
 *      launchwait(命令行)        启动外部程序并**等它跑完**，
 *                                返回它的退出码（起不来返回 -1）
 *
 *  注意：C_OPED.cash 里的 launch() 是"启动就返回"，这个头里的
 *        launchwait() 是"跑完才返回"；一个看门狗，一个跟班。
 *
 *  文件内容上限 readfile 为 1MB（再大的文件请分块读的需求请直接
 *  用 C/C++ 头文件去做）。
 * ============================================================ */
#ifndef CASK_IO_CASH
#define CASK_IO_CASH

#ifdef _WIN32

#include <windows.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <wchar.h>

/* ---- UTF-8 <-> UTF-16（轮转缓冲区，单线程事件循环里够用） ---- */
static WCHAR *cask_io_wide(const char *s)
{
    static WCHAR buf[8][1024];
    static int slot = 0;
    WCHAR *out = buf[slot];
    slot = (slot + 1) & 7;
    if (!s) { out[0] = 0; return out; }
    if (!MultiByteToWideChar(CP_UTF8, 0, s, -1, out, 1024)) out[0] = 0;
    return out;
}
static const char *cask_io_utf8(const WCHAR *w)
{
    static char buf[8][4096];
    static int slot = 0;
    char *out = buf[slot];
    slot = (slot + 1) & 7;
    if (!w) { out[0] = 0; return out; }
    if (!WideCharToMultiByte(CP_UTF8, 0, w, -1, out, 4096, NULL, NULL)) out[0] = 0;
    return out;
}

/* ---- readfile: whole file into a rotating 1MB buffer ---- */
static const char *cask_io_readfile(const char *path)
{
    static char buf[4][0x100000];
    static int slot = 0;
    char *out = buf[slot];
    HANDLE h;
    LARGE_INTEGER sz;
    DWORD got = 0;
    slot = (slot + 1) & 3;
    out[0] = 0;
    if (!path || !*path) return out;
    h = CreateFileW(cask_io_wide(path), GENERIC_READ, FILE_SHARE_READ, NULL,
                    OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
    if (h == INVALID_HANDLE_VALUE) return out;
    if (!GetFileSizeEx(h, &sz) || sz.QuadPart < 0 || sz.QuadPart >= 0x100000 - 8) {
        CloseHandle(h);
        return out;
    }
    ReadFile(h, out, (DWORD)sz.QuadPart, &got, NULL);
    out[got] = 0;
    CloseHandle(h);
    return out;
}

/* ---- writefile / appendfile ---- */
static long long cask_io_writefile(const char *path, const char *data)
{
    HANDLE h;
    DWORD len = data ? (DWORD)strlen(data) : 0, n = 0;
    if (!path || !*path) return 0;
    h = CreateFileW(cask_io_wide(path), GENERIC_WRITE, 0, NULL,
                    CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
    if (h == INVALID_HANDLE_VALUE) return 0;
    if (len) WriteFile(h, data, len, &n, NULL);
    CloseHandle(h);
    return n == len ? 1 : 0;
}
static long long cask_io_appendfile(const char *path, const char *data)
{
    HANDLE h;
    DWORD len = data ? (DWORD)strlen(data) : 0, n = 0;
    if (!path || !*path) return 0;
    h = CreateFileW(cask_io_wide(path), FILE_APPEND_DATA, 0, NULL,
                    OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
    if (h == INVALID_HANDLE_VALUE) return 0;
    if (len) WriteFile(h, data, len, &n, NULL);
    CloseHandle(h);
    return n == len ? 1 : 0;
}

/* ---- existence / directories ---- */
static long long cask_io_fileexists(const char *path)
{
    DWORD a;
    if (!path || !*path) return 0;
    a = GetFileAttributesW(cask_io_wide(path));
    return a != INVALID_FILE_ATTRIBUTES ? 1 : 0;
}
static long long cask_io_makedir(const char *path)
{
    if (!path || !*path) return 0;
    if (CreateDirectoryW(cask_io_wide(path), NULL)) return 1;
    return GetLastError() == ERROR_ALREADY_EXISTS ? 1 : 0;
}

/* ---- appdir / envget ---- */
static const char *cask_io_appdir(void)
{
    WCHAR w[1024];
    DWORD n = GetModuleFileNameW(NULL, w, 1024);
    WCHAR *bs;
    if (!n || n >= 1024) return "";
    w[n] = 0;
    bs = wcsrchr(w, L'\\');
    if (bs) *bs = 0;
    return cask_io_utf8(w);
}
static const char *cask_io_envget(const char *name)
{
    static WCHAR wbuf[4096];
    DWORD n;
    if (!name || !*name) return "";
    n = GetEnvironmentVariableW(cask_io_wide(name), wbuf, 4096);
    if (!n || n >= 4096) return "";
    return cask_io_utf8(wbuf);
}

/* ---- launchwait: start and WAIT for the exit code ---- */
static long long cask_io_launchwait(const char *cmd)
{
    STARTUPINFOW si;
    PROCESS_INFORMATION pi;
    DWORD code = (DWORD)-1;
    if (!cmd || !*cmd) return -1;
    memset(&si, 0, sizeof si);
    memset(&pi, 0, sizeof pi);
    si.cb = sizeof si;
    if (!CreateProcessW(NULL, cask_io_wide(cmd), NULL, NULL, FALSE,
                        0, NULL, NULL, &si, &pi))
        return -1;
    WaitForSingleObject(pi.hProcess, INFINITE);
    GetExitCodeProcess(pi.hProcess, &code);
    CloseHandle(pi.hThread);
    CloseHandle(pi.hProcess);
    return (long long)code;
}

#else  /* ===================== Linux / macOS ===================== */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <errno.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <sys/wait.h>

/* ---- readfile (1MB 上限) ---- */
static const char *cask_io_readfile(const char *path)
{
    static char buf[4][0x100000];
    static int slot = 0;
    char *out = buf[slot];
    FILE *f;
    size_t got;
    slot = (slot + 1) & 3;
    out[0] = 0;
    if (!path || !*path) return out;
    f = fopen(path, "rb");
    if (!f) return out;
    got = fread(out, 1, 0x100000 - 8, f);
    out[got] = 0;
    fclose(f);
    return out;
}

/* ---- writefile / appendfile ---- */
static long long cask_io_writefile(const char *path, const char *data)
{
    FILE *f;
    size_t len = data ? strlen(data) : 0, n = 0;
    if (!path || !*path) return 0;
    f = fopen(path, "wb");
    if (!f) return 0;
    if (len) n = fwrite(data, 1, len, f);
    fclose(f);
    return n == len ? 1 : 0;
}
static long long cask_io_appendfile(const char *path, const char *data)
{
    FILE *f;
    size_t len = data ? strlen(data) : 0, n = 0;
    if (!path || !*path) return 0;
    f = fopen(path, "ab");
    if (!f) return 0;
    if (len) n = fwrite(data, 1, len, f);
    fclose(f);
    return n == len ? 1 : 0;
}

/* ---- existence / directories ---- */
static long long cask_io_fileexists(const char *path)
{
    struct stat st;
    if (!path || !*path) return 0;
    return stat(path, &st) == 0 ? 1 : 0;
}
static long long cask_io_makedir(const char *path)
{
    if (!path || !*path) return 0;
    if (mkdir(path, 0755) == 0) return 1;
    return errno == EEXIST ? 1 : 0;
}

/* ---- appdir / envget ---- */
static const char *cask_io_appdir(void)
{
    static char path[1024];
    ssize_t n;
    char *sl;
    n = readlink("/proc/self/exe", path, sizeof path - 1);
    if (n <= 0) return "";          /* macOS: 没有 /proc，返回空 */
    path[n] = 0;
    sl = strrchr(path, '/');
    if (sl) *sl = 0;
    return path;
}
static const char *cask_io_envget(const char *name)
{
    const char *v;
    if (!name || !*name) return "";
    v = getenv(name);
    return v ? v : "";
}

/* ---- launchwait: fork + sh -c, wait for the exit code ---- */
static long long cask_io_launchwait(const char *cmd)
{
    pid_t pid;
    int status = 0;
    if (!cmd || !*cmd) return -1;
    pid = fork();
    if (pid < 0) return -1;
    if (pid == 0) {
        execl("/bin/sh", "sh", "-c", cmd, (char *)NULL);
        _exit(127);
    }
    if (waitpid(pid, &status, 0) < 0) return -1;
    if (WIFEXITED(status)) return (long long)WEXITSTATUS(status);
    return -1;
}

#endif /* _WIN32 / POSIX */

#endif /* CASK_IO_CASH */
